# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# For local dev without Docker, sqlite is used automatically if unset.
# For Docker/production, use PostgreSQL:
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/talent_ai

# --- Auth ---
# Generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- URLs ---
# Your deployed frontend URL - used to build password-reset links in emails,
# and to allow cross-origin requests from the frontend.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- File uploads ---
MAX_UPLOAD_SIZE_MB=10

# --- Resume storage backend ---
# "local": saves to UPLOAD_DIR on disk. IMPORTANT: on most PaaS hosts
#   (Railway/Render/Heroku free tiers) local disk is WIPED on every
#   redeploy - uploaded resumes would be permanently lost. Use only for
#   local development.
# "s3": saves to AWS S3 or any S3-compatible service (Cloudflare R2,
#   MinIO, DigitalOcean Spaces). Survives redeploys. Use this in production.
# Verify your setup with: python ../scripts/verify_s3_storage.py
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# Only for non-AWS S3-compatible providers (R2/MinIO/Spaces). Blank = real AWS.
S3_ENDPOINT_URL=

# --- Email notifications ---
# "console": logs emails instead of sending - zero setup, but real users
#   receive NOTHING. Fine for local dev only.
# "smtp": sends real emails (Gmail, SendGrid, Mailgun, etc).
# Verify your setup with: python ../scripts/verify_smtp_email.py you@email.com
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
# For Gmail: use an "App Password", NOT your normal password -
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true

# --- Semantic matching backend ---
# tfidf = always available, no external calls (default)
# sbert = sentence-transformers, requires Hugging Face model access at deploy time
SEMANTIC_BACKEND=tfidf
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# --- Match score weights (should sum to 1.0) ---
WEIGHT_SKILL_MATCH=0.35
WEIGHT_SEMANTIC=0.25
WEIGHT_EXPERIENCE=0.20
WEIGHT_PROJECTS=0.10
WEIGHT_EDUCATION=0.05
WEIGHT_CERTIFICATIONS=0.05

# --- Proactive job-match notifications ---
# When a job is posted, candidates whose latest resume scores at or above
# this threshold (0-1 scale) against it get notified automatically.
NEW_JOB_MATCH_THRESHOLD=0.5

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
